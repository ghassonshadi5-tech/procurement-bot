# =============================================================================
# Procurement Bot — Environment Variables Template
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file to .env
#        cp .env.example .env
#   2. Fill in your real values.
#   3. NEVER commit .env to version control (it should be in .gitignore).
#
# All variables are read by app/config/settings.py using pydantic-settings.
# Missing required fields (marked "REQUIRED") will cause the bot to fail at
# startup with a clear error message (Fail Fast principle).
#
# =============================================================================


# =============================================================================
# Telegram Bot Configuration
# =============================================================================

# REQUIRED. The bot token issued by @BotFather on Telegram.
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz-1234567
# SECURITY: never commit the real token to any repository.
BOT_TOKEN=your_telegram_bot_token_here

# REQUIRED. The bot's public username (without the leading @).
# Used to build deep links like https://t.me/<username>?start=...
# Example: shadi_procurement_bot
BOT_USERNAME=your_bot_username_here

# REQUIRED. Your personal Telegram user ID (the platform Super Admin).
# The first startup will assign the super_admin role to this user.
# Find your ID by messaging @userinfobot on Telegram.
SUPER_ADMIN_TELEGRAM_ID=123456789


# =============================================================================
# Database Configuration (PostgreSQL 15+)
# =============================================================================

# REQUIRED. Standard PostgreSQL URL (asyncpg is used automatically by
# app/database/database.py — do NOT add "+asyncpg" here).
# SECURITY: use a strong password and never commit the real one.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/procurement_bot


# =============================================================================
# Application Environment
# =============================================================================

# Optional. One of: development | staging | production.
# Defaults to "development" if unset.
# In "production", DEBUG must be False and the DB password must not be
# the placeholder "password".
APP_ENV=development

# Optional. When True, verbose SQL statements are echoed to the logs.
# SECURITY: keep False in production (SQL may contain PII or prices).
# Default: False
DEBUG=False

# Optional. Log level for the application logger.
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL.
# Default: INFO
LOG_LEVEL=INFO

# Optional. When True, SQLAlchemy echoes raw SQL to logs.
# Kept separate from DEBUG to prevent accidental SQL leaks.
# Default: False
SQL_ECHO=False


# =============================================================================
# Logging Configuration
# =============================================================================

# Optional. Directory where rotating log files are written.
# Default: <project_root>/logs
# LOG_DIR=./logs

# Optional. Max size of a single log file before rotation (bytes).
# Default: 10485760 (10 MB)
# LOG_MAX_BYTES=10485760

# Optional. Number of rotated log files to keep per handler.
# Default: 10
# LOG_BACKUP_COUNT=10


# =============================================================================
# Localization (i18n)
# =============================================================================

# Optional. Default language used when the user's language is unset.
# Must be one of SUPPORTED_LANGUAGES. Default: ar
# DEFAULT_LANGUAGE=ar

# Optional. Comma-separated list of supported language codes.
# Arabic is mandatory (the bot appends it if missing).
# Default: ar,ru,en
# SUPPORTED_LANGUAGES=ar,ru,en


# =============================================================================
# Timezone
# =============================================================================

# Optional. IANA timezone used for deadline calculations and audit
# timestamps. Must be a valid IANA name (e.g. UTC, Europe/Moscow,
# Asia/Riyadh). Default: UTC
# TIMEZONE=UTC


# =============================================================================
# Scheduler
# =============================================================================

# Optional. When True, the background scheduler is started at boot.
# Default: True
# SCHEDULER_ENABLED=True

# Optional. Interval (seconds) between RFQ deadline checks.
# Default: 60
# RFQ_DEADLINE_CHECK_INTERVAL_SECONDS=60


# =============================================================================
# Attachments Storage
# =============================================================================

# Optional. Filesystem path for storing attachments.
# Default: <project_root>/storage/attachments
# ATTACHMENTS_STORAGE_PATH=./storage/attachments

# Optional. Max attachment size in bytes.
# Default: 20971520 (20 MB — Telegram Bot API limit).
# MAX_ATTACHMENT_SIZE_BYTES=20971520


# =============================================================================
# RFQ Defaults
# =============================================================================

# Optional. Default competition window (hours) for open RFQs.
# Must be one of RFQ_DEADLINE_OPTIONS_HOURS.
# Default: 6
# DEFAULT_RFQ_DEADLINE_HOURS=6

# Optional. Allowed competition windows (hours) exposed to users.
# Comma-separated list. Default: 2,6,24
# RFQ_DEADLINE_OPTIONS_HOURS=2,6,24